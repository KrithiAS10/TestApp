generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Order {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  productId   String
  quantity    Int
  totalAmount Float
  status      String
  createdAt   DateTime @default(now())
}
